{
  "permissions": {
    "allow": [
      "Read(~/**)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(curl *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(xxd *)",
      "Bash(kubectl *)",
      "Edit(.claude)",
      "Bash(git *)",
      "Bash(claude plugin *)",
      "mcp__claude_ai_Atlassian_Rovo_2",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/thamnguyen-covergo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s' \"BREVITY RULE ACTIVE (~/.claude/rules/brevity.md). Answer as: Problem (1 sentence) / Action (verbatim command or diff) / Caveat (<=1 line, only if omitting it breaks something). Max 3 prose lines outside code blocks. No preamble, no summary of work done, no unrequested alternatives or tradeoffs, no mechanism unless asked why/how. Never cut: security, data-loss, irreversible-action warnings, ordered multi-step sequences.\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "skill-creator@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "preferredNotifChannel": "ghostty",
  "switchModelsOnFlag": false
}
